# --- Reader (browser; these two are public by design, protected by RLS + auth) ---
# Leave blank to run in local demo mode (sample content, state in this browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to /<repo-name> when deploying to https://<user>.github.io/<repo-name>/
NEXT_PUBLIC_BASE_PATH=

# --- Editor / ingestion (NEVER put these in the browser or the repo) ---
# Used by scripts/ingest-file.mjs and by Claude scheduled tasks.
PENNY_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/ingest
PENNY_INGEST_TOKEN=
